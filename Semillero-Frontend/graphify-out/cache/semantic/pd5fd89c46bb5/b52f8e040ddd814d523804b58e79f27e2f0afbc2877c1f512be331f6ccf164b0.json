{"nodes": [{"id": "specs_db_security_design_c1_webhook_no_auth", "label": "C1: n8n Webhook Sin Autenticaci\u00f3n", "file_type": "rationale", "source_file": "specs/db_security_design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The anon key is public by design, so RLS is the real security boundary, not the frontend; the n8n webhook is mounted without auth and trusts a client-supplied company_id, allowing arbitrary candidate injection."}, {"id": "specs_db_security_design_c2_profiles_no_rls", "label": "C2: profiles sin RLS \u2192 escalada de privilegios", "file_type": "rationale", "source_file": "specs/db_security_design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every RLS policy in the system resolves company scope by reading profiles.company_id; without RLS on profiles a user could rewrite their own role or company_id and defeat multi-tenant isolation entirely."}, {"id": "specs_db_security_design_h1_vacancies_open", "label": "H1: vacancies abierta entre empresas", "file_type": "concept", "source_file": "specs/db_security_design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_db_security_design_h2_vacancies_anon", "label": "H2: Vacantes expuestas a an\u00f3nimos", "file_type": "concept", "source_file": "specs/db_security_design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_db_security_design_h3_company_enum", "label": "H3: Enumeraci\u00f3n de empresas", "file_type": "concept", "source_file": "specs/db_security_design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_db_security_design_m1_postgrest_injection", "label": "M1: Inyecci\u00f3n de filtros PostgREST", "file_type": "concept", "source_f