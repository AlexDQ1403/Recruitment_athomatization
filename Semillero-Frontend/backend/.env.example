NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3002

OPENAI_API_KEY=sk-proj-...

# Supabase → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# service_role: requerida para el CRUD de reclutadores y escrituras sin RLS
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# LLM del chat vía OpenRouter (https://openrouter.ai/keys).
# OPENAI_API_KEY solo si prefieres OpenAI directo (sin OPENROUTER_API_KEY).
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Opcional: sin esto los triggers de n8n solo dejan un warning en el log
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/semillero
# N8N_WEBHOOK_SECRET=
